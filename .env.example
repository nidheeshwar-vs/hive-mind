# Copy to .env for local development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
IOT_API_KEY=change-me-iot-key
# Optional: used in machine passport QR codes (set to your deployed URL)
PUBLIC_URL=
# Where the SQLite DB + uploads live (use a persistent disk in production)
DATA_DIR=./data
# Set to false to stop the built-in IoT simulator once real devices post telemetry
SIMULATE_IOT=true
